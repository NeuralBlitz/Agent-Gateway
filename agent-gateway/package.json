{
  "name": "agent-gateway",
  "version": "1.0.0",
  "description": "Universal AI agent gateway — connect any messaging platform to any AI provider",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "agent-gateway": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json",
    "./cli": {
      "import": "./dist/cli/index.js",
      "types": "./dist/cli/index.d.ts",
      "require": "./dist/cli/index.cjs"
    },
    "./gateway": {
      "import": "./dist/gateway/index.js",
      "types": "./dist/gateway/index.d.ts",
      "require": "./dist/gateway/index.cjs"
    },
    "./plugin-sdk": {
      "import": "./dist/plugin-sdk/index.js",
      "types": "./dist/plugin-sdk/index.d.ts",
      "require": "./dist/plugin-sdk/index.cjs"
    },
    "./channels": {
      "import": "./dist/channels/index.js",
      "types": "./dist/channels/index.d.ts"
    },
    "./providers": {
      "import": "./dist/providers/index.js",
      "types": "./dist/providers/index.d.ts"
    },
    "./agents": {
      "import": "./dist/agents/index.js",
      "types": "./dist/agents/index.d.ts"
    },
    "./sessions": {
      "import": "./dist/sessions/index.js",
      "types": "./dist/sessions/index.d.ts"
    },
    "./hooks": {
      "import": "./dist/hooks/index.js",
      "types": "./dist/hooks/index.d.ts"
    },
    "./auto-reply": {
      "import": "./dist/auto-reply/index.js",
      "types": "./dist/auto-reply/index.d.ts"
    },
    "./auth": {
      "import": "./dist/auth/index.js",
      "types": "./dist/auth/index.d.ts"
    },
    "./ratelimit": {
      "import": "./dist/ratelimit/index.js",
      "types": "./dist/ratelimit/index.d.ts"
    },
    "./webhooks": {
      "import": "./dist/webhooks/index.js",
      "types": "./dist/webhooks/index.d.ts"
    },
    "./config": {
      "import": "./dist/config/index.js",
      "types": "./dist/config/index.d.ts"
    },
    "./infra": {
      "import": "./dist/infra/index.js",
      "types": "./dist/infra/index.d.ts"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "dev": "tsx watch src/cli/index.ts",
    "start": "node ./dist/cli/index.js",
    "test": "vitest",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist/",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ai",
    "agent",
    "gateway",
    "telegram",
    "discord",
    "slack",
    "whatsapp",
    "signal",
    "matrix",
    "openai",
    "anthropic",
    "claude",
    "google",
    "gemini",
    "ollama",
    "multi-channel",
    "multi-provider",
    "chatbot",
    "llm"
  ],
  "author": "agent-gateway contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/agent-gateway/agent-gateway.git"
  },
  "bugs": {
    "url": "https://github.com/agent-gateway/agent-gateway/issues"
  },
  "homepage": "https://github.com/agent-gateway/agent-gateway#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@libsql/client": "^0.17.2",
    "bcryptjs": "^3.0.3",
    "conf": "^12.0.0",
    "dotenv": "^17.4.1",
    "emittery": "^1.0.0",
    "env-paths": "^3.0.0",
    "exponential-backoff": "^3.1.1",
    "express": "^5.2.1",
    "find-my-way": "^8.2.0",
    "ioredis": "^5.10.1",
    "jose": "^6.2.2",
    "jsonwebtoken": "^9.0.3",
    "lru-cache": "^10.2.0",
    "p-debounce": "^4.0.0",
    "p-filter": "^3.0.0",
    "p-map": "^6.0.0",
    "p-queue": "^8.0.1",
    "p-retry": "^6.2.0",
    "p-throttle": "^6.1.0",
    "p-timeout": "^6.1.0",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "prom-client": "^15.1.3",
    "rate-limiter-flexible": "^5.0.0",
    "rolldown": "^1.0.0-beta.7",
    "stacktracey": "^2.1.8",
    "tar": "^7.5.13",
    "terminal-columns": "^2.0.0",
    "undici": "^6.19.0",
    "uuid": "^14.0.0",
    "which": "^4.0.0",
    "ws": "^8.17.0",
    "yaml": "^2.4.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.14.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "eslint": "^8.57.0",
    "tsdown": "^0.21.7",
    "tsx": "^4.15.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.4"
  }
}
